<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Examples read as documentation: console output and simple names are fine. -->
    <NoWarn>$(NoWarn);CA1303;CA1515;CA2007;CA1031;CA1812;CA1852;CA1848</NoWarn>
  </PropertyGroup>
</Project>
