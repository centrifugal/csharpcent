<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SDK in a native AOT application: dotnet publish fails on any trimming or AOT warning. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Centrifugal.Cent/Centrifugal.Cent.csproj" />
  </ItemGroup>
</Project>
